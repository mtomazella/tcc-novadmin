{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",

        "module": "nodenext",
        "target": "esnext",
        "moduleResolution": "nodenext",
        "declaration": true,
        "declarationMap": true,
        "emitDeclarationOnly": false,

        "strict": true,
        "jsx": "react-jsx",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true,
        "esModuleInterop": true,
        "sourceMap": true,

        "baseUrl": ".",
        "paths": {
            "types/*": ["./src/types/*"],
            "quote/*": ["./src/quote/*"],
            "utils/*": ["./src/utils/*"]
        }
    },
    "include": ["src/**/*"]
}
