{
    "name": "novadmin",
    "version": "1.0.0",
    "main": "index.js",
    "license": "MIT",
    "scripts": {
        "build": "tsc",
        "lint": "eslint 'src/**/*.ts'",
        "start": "node dist/index.js",
        "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node -r tsconfig-paths/register' src/index.ts",
        "generateUsers": "node ./database/generateUserSql.js",
        "docker:local": "docker compose -f ./docker-compose.local.yml",
        "docker:backup": "docker compose -f ./docker-compose.backup.yml",
        "local": "ENV_FILE=.env.local npm run dev",
        "local-prod": "ENV_FILE=.env.local-prod npm run dev",
        "backup": "ENV_FILE=.env.backup npm run dev"
    },
    "dependencies": {
        "@novadmin/lib": "github:mtomazella/NovaERP-Lib#v2.0.0",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.19",
        "@types/lodash": "^4.17.23",
        "bcrypt": "^6.0.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^5.1.0",
        "jose": "^6.0.11",
        "lodash": "^4.17.21",
        "postgres": "3.4.7",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.1",
        "@types/node": "^22.14.0",
        "eslint": "^9.23.0",
        "nodemon": "^3.1.9",
        "prettier": "^3.5.3",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.2"
    }
}
